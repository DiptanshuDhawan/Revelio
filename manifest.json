{
  "manifest_version": 3,
  "name": "Revelio",
  "version": "1.0.0",
  "description": "AI-powered phishing email analyzer with multi-layer rule engine and LLM analysis. Protect your organization from phishing, BEC, and social engineering attacks.",
  "author": "Revelio Security Team",

  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],

  "host_permissions": [
    "http://localhost:11434/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://safebrowsing.googleapis.com/*",
    "https://www.virustotal.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:11434 https://api.openai.com https://generativelanguage.googleapis.com https://safebrowsing.googleapis.com https://www.virustotal.com;"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Revelio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_page": "settings/settings.html",

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "popup/*", "settings/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
